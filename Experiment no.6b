#include <iostream>
using namespace std;

class Vehicle
{
public:
    Vehicle()
    {
        cout << "This is a vehicle" << endl;
    }
};

class Car : public Vehicle
{
public:
    Car()
    {
        cout << "This vehicle is Car" << endl;
    }
};

class Bus : public Vehicle
{
public:
    Bus()
    {
        cout << "This vehicle is Bus" << endl;
    }
};

int main()
{
    Car obj1;
    Bus obj2;

    return 0;
}
